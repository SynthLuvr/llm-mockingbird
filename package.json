{
  "name": "llm-mockingbird",
  "version": "0.1.0",
  "description": "Mock LLM provider APIs (Anthropic and OpenAI) for testing purposes",
  "keywords": [
    "mock",
    "mockingbird",
    "llm",
    "anthropic",
    "openai",
    "claude",
    "testing",
    "test-double",
    "fastify",
    "sse"
  ],
  "author": "SynthLuvr (https://github.com/SynthLuvr)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SynthLuvr/llm-mockingbird.git"
  },
  "bugs": {
    "url": "https://github.com/SynthLuvr/llm-mockingbird/issues"
  },
  "homepage": "https://github.com/SynthLuvr/llm-mockingbird#readme",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "==26"
  },
  "bin": {
    "llm-mockingbird": "./bin/llm-mockingbird"
  },
  "main": "./src/create-mock.ts",
  "exports": {
    ".": "./src/create-mock.ts"
  },
  "files": ["bin", "src", "!src/tests"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "format": "ts-canon format",
    "lint": "ts-canon lint",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "arktype": "^2.2.3",
    "fastify": "5.12.3",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "execa": "^10.0.1",
    "ky": "^2.1.0",
    "ts-canon": "^0.1.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
